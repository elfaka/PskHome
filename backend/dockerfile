# PskHome 백엔드 (Express + TypeScript)
#
# 기존에는 stock `openjdk:21-jdk-slim` 이미지에 빌드된 JAR 만 볼륨으로 물려 실행했다.
# Node 앱은 실행에 node_modules 가 필요하므로, 이미지를 직접 빌드한다.
#
# 이 이미지는 GitHub Actions 에서 빌드해 GHCR 로 올라간다 (서버에서 빌드하지 않는다).
# 로컬에서 확인하려면: `docker build -f backend/dockerfile -t pskhome-be backend`

FROM node:22-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# prisma generate + tsc
RUN npm run build


FROM node:22-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production

COPY package.json package-lock.json ./
COPY prisma ./prisma

RUN npm ci --omit=dev && npm cache clean --force

# 빌드 단계에서 생성된 Prisma Client 를 그대로 가져온다.
# (runner 에는 prisma CLI 가 없으므로 여기서 generate 할 수 없다)
#
# [주의] prisma generate 는 산출물을 두 곳에 만든다:
#   - node_modules/@prisma/client : 얇은 진입점. `require('.prisma/client/default')` 로 재export 한다.
#   - node_modules/.prisma/client : 실제 생성된 클라이언트 코드
# 둘 중 하나라도 빠지면 Node 의 ESM↔CJS 인터롭이 named export 를 찾지 못해
# `SyntaxError: Named export 'PrismaClient' not found` 로 기동 즉시 죽는다.
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/node_modules/@prisma/client ./node_modules/@prisma/client
COPY --from=builder /app/dist ./dist

# 이미지 빌드 시점에 앱 모듈 그래프를 실제로 import 해본다.
# 위와 같은 런타임 전용 문제(누락된 의존성, ESM/CJS 인터롭)를
# 프로덕션 crash-loop 가 아니라 빌드 실패로 잡아내기 위한 검증이다.
RUN node --input-type=module -e "await import('./dist/app.js'); console.log('startup check ok')"

EXPOSE 8080

CMD ["node", "dist/index.js"]
