# PskHome 백엔드 (Express + TypeScript)
#
# 기존에는 stock `openjdk:21-jdk-slim` 이미지에 빌드된 JAR 만 볼륨으로 물려 실행했다.
# Node 앱은 실행에 node_modules 가 필요하므로, 이미지를 직접 빌드한다.
# (레지스트리 없이 서버에서 `docker compose up -d --build` 로 빌드한다)

FROM node:22-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# prisma generate + tsc
RUN npm run build


FROM node:22-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production

COPY package.json package-lock.json ./
COPY prisma ./prisma

RUN npm ci --omit=dev && npm cache clean --force

# 빌드 단계에서 생성된 Prisma Client 를 그대로 가져온다.
# (runner 에는 prisma CLI 가 없으므로 여기서 generate 할 수 없다)
COPY --from=builder /app/node_modules/@prisma/client ./node_modules/@prisma/client
COPY --from=builder /app/dist ./dist

EXPOSE 8080

CMD ["node", "dist/index.js"]
