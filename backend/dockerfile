# PskHome 백엔드 (Express + TypeScript)
#
# 기존에는 stock `openjdk:21-jdk-slim` 이미지에 빌드된 JAR 만 볼륨으로 물려 실행했다.
# Node 앱은 실행에 node_modules 가 필요하므로, 이미지를 직접 빌드한다.
# (레지스트리 없이 서버에서 `docker compose up -d --build` 로 빌드한다)

FROM node:22-alpine AS builder

WORKDIR /app

# 이 이미지는 배포 서버(VPS)에서 직접 빌드된다. MySQL·프론트엔드·traefik 이
# 같이 떠 있는 상태라 tsc 가 힙을 크게 잡으면 커널 OOM killer 가 빌드가 아니라
# sshd 를 죽여 배포가 "exited without exit status" 로 끊긴다.
#
# 상한을 걸어두면 그 상황이 컨테이너 안의 명확한 실패
# ("JavaScript heap out of memory")로 바뀌어 원인을 바로 알 수 있다.
# skipLibCheck 를 켠 이 규모의 프로젝트에는 512MB 면 넉넉하다.
# 소스가 커져서 이 한도에 걸리면 값을 올린다.
ENV NODE_OPTIONS=--max-old-space-size=512

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# prisma generate + tsc
RUN npm run build


FROM node:22-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production

COPY package.json package-lock.json ./
COPY prisma ./prisma

RUN npm ci --omit=dev && npm cache clean --force

# 빌드 단계에서 생성된 Prisma Client 를 그대로 가져온다.
# (runner 에는 prisma CLI 가 없으므로 여기서 generate 할 수 없다)
#
# [주의] prisma generate 는 산출물을 두 곳에 만든다:
#   - node_modules/@prisma/client : 얇은 진입점. `require('.prisma/client/default')` 로 재export 한다.
#   - node_modules/.prisma/client : 실제 생성된 클라이언트 코드
# 둘 중 하나라도 빠지면 Node 의 ESM↔CJS 인터롭이 named export 를 찾지 못해
# `SyntaxError: Named export 'PrismaClient' not found` 로 기동 즉시 죽는다.
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/node_modules/@prisma/client ./node_modules/@prisma/client
COPY --from=builder /app/dist ./dist

# 이미지 빌드 시점에 앱 모듈 그래프를 실제로 import 해본다.
# 위와 같은 런타임 전용 문제(누락된 의존성, ESM/CJS 인터롭)를
# 프로덕션 crash-loop 가 아니라 빌드 실패로 잡아내기 위한 검증이다.
RUN node --input-type=module -e "await import('./dist/app.js'); console.log('startup check ok')"

EXPOSE 8080

CMD ["node", "dist/index.js"]
