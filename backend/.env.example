NODE_ENV=development
PORT=8080

# --- MySQL (Prisma) ---
# 기존 application-local.yaml 의 spring.datasource 설정과 동일한 DB 를 가리킨다.
# 사용자명/비밀번호에 @ : / ? # 가 들어가면 퍼센트 인코딩할 것 (예: p@ss -> p%40ss)
DATABASE_URL=mysql://root:password@localhost:3306/page

# --- 세션 ---
SESSION_SECRET=change-me
SESSION_COOKIE_NAME=psk.sid

# --- Google OAuth2 ---
# GOOGLE_CALLBACK_URL 은 Google Cloud Console 의 "승인된 리디렉션 URI" 와 정확히 일치해야 한다.
# Spring Security 시절과 동일한 경로를 유지하므로 콘솔 설정을 바꿀 필요는 없다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/api/login/oauth2/code/google
APP_LOGIN_SUCCESS_REDIRECT=http://localhost:5173/googleform/forms

# --- 토스증권 Open API (모의투자 시세) ---
# 토스증권 WTS > 설정 > Open API 에서 발급한다. 시세 조회에만 쓰고 주문 API 는 호출하지 않는다.
# 호출하는 IP(로컬 공인 IP, 운영 서버 IP)를 같은 화면의 "허용 IP 관리"에 등록해야 한다. 없으면 403.
# 토큰은 client 당 1개만 유효하므로, 로컬과 운영이 같은 키를 쓰면 서로의 토큰을 무효화한다.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# --- OpenDART (모의투자 재무 지표: PER·EPS·PBR·ROE·배당) ---
# https://opendart.fss.or.kr 에서 무료 발급 (하루 2만 건). 없으면 재무 지표만 빠지고 나머지는 동작한다.
DART_API_KEY=

# --- Cboe 공개 데이터 (모의투자 VIX 지수) ---
# 키가 필요 없다. 기본값을 쓰면 되고, 로컬에서 가짜 서버로 확인할 때만 바꾼다.
# CBOE_API_BASE_URL=https://cdn-api.cboe.com/api/global

# --- SerpApi (항공권 최저가 검색, Google Flights 엔진) ---
# https://serpapi.com 에서 발급 (무료 월 250회). 없으면 /api/flights 검색만 503.
# 테스트는 SerpApi 를 부르지 않는다. 로컬 화면 확인 때는 한도가 줄어드니 같은 조건 반복 검색(30분 캐시)을 활용한다.
SERPAPI_API_KEY=
# 로그인 사용자 1명이 하루(KST)에 실제로 검색할 수 있는 횟수 (캐시 적중은 세지 않는다)
# FLIGHTS_DAILY_LIMIT=30
