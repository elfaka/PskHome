NODE_ENV=development
PORT=8080

# --- MySQL (Prisma) ---
# 기존 application-local.yaml 의 spring.datasource 설정과 동일한 DB 를 가리킨다.
DATABASE_URL=mysql://root:password@localhost:3306/page

# --- 세션 ---
SESSION_SECRET=change-me
SESSION_COOKIE_NAME=psk.sid

# --- Google OAuth2 ---
# GOOGLE_CALLBACK_URL 은 Google Cloud Console 의 "승인된 리디렉션 URI" 와 정확히 일치해야 한다.
# Spring Security 시절과 동일한 경로를 유지하므로 콘솔 설정을 바꿀 필요는 없다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/api/login/oauth2/code/google
APP_LOGIN_SUCCESS_REDIRECT=http://localhost:5173/googleform/forms
