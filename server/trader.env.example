# 서버의 server/trader.env 템플릿. 복사해서 서버에서만 채운다 (git·채팅·로그에 남기지 않는다).
#   cp trader.env.example trader.env && chmod 600 trader.env
# 비밀번호는 trader/db/create_users.sql 을 실행할 때 정한 값이다.
# 비밀번호에 @ : / ? # 가 있으면 퍼센트 인코딩한다.

TRADER_DATABASE_URL=mysql+pymysql://trader_app:<APP_PASSWORD>@pskhome-db-1:3306/trader
TRADER_MIGRATE_DATABASE_URL=mysql+pymysql://trader_migrate:<MIGRATE_PASSWORD>@pskhome-db-1:3306/trader

TRADER_ACCOUNT_NAME=paper-default
TRADER_SYMBOLS=005930,000660
# 시세 출처(stocksim)·장중 규칙·전략 기본값은 trader/.env.example 참고

# ═════════════════════════════════════════════════════════════════════════════
# ⚠️ 운영 설정은 DB 가 원본이다 (2026-11-27 부터).
#   수수료·세율·원 단위 처리·슬리피지·체결 비율·1회 매수 금액·위험 한도·ATR 배수·최소 손익비·최대 스프레드·
#   신규 매수 마감(ENTRY_CUTOFF)·장마감 청산(EOD_EXIT) 은 /trader → 설정 에서 바꾼다 (재시작 없이 약 5초 안에 적용).
#   엔진이 처음 뜰 때 DB 에 운영 설정이 없으면 이 파일의 값을 **한 번만** DB 로 옮긴다.
#   그 뒤에는 이 파일의 같은 값은 무시된다 (화면 설정에 "쓰이지 않는 값"으로 표시) — 지워도 된다.
#   PAPER_INITIAL_CASH·DB 주소·계좌·종목·전략은 계속 이 파일에서 정한다.
#
# 아래 값은 1단계 가상매매용 **임의 시작값**이다 (사용자 요청으로 채움, 2026-11-27).
# 실제 돈이 오가지 않는다. 신호 성과(/trader 대시보드)를 보고 조정한다.
# 코드에는 기본값이 없어서, DB 에도 이 파일에도 없으면 엔진이 기동하지 않는다.
#
# 참고 시세 (2026-11-27 장중): 삼성전자 005930 ≈ 170,000원, SK하이닉스 000660 ≈ 1,030,000원
# → 1회 매수 금액이 하이닉스 1주 값보다 작으면 하이닉스는 아예 사지 못한다.
#
# ── 요약표 (항목별 자세한 설명은 각 값 위 주석) ────────────────────────────────
# 항목                      | 값            | 의미                                       | ↑ 올리면                                       | ↓ 내리면
# --------------------------|---------------|--------------------------------------------|------------------------------------------------|----------------------------------
# PAPER_INITIAL_CASH        | 1,000만원     | 가상 계좌 시작 현금 (처음 기동할 때만 씀)  | 여러 종목을 동시에 보유 가능                   | 1회 매수 금액보다 작으면 매수 불가
# COMMISSION_RATE_BUY/SELL  | 0.015%        | 매수·매도 수수료                           | 비용 증가 → 손익 악화, 매수가 더 자주 막힘     | 성과가 실제보다 좋게 보임
# SELL_TAX_RATE             | 0.20%         | 매도할 때만 붙는 세금 (비용 중 가장 큼)    | 짧게 자주 사고파는 매매에 특히 불리            | 성과가 과대평가됨
# FEE_ROUNDING              | down          | 수수료·세금의 원 미만 절사                 | (half_up 이면 반올림) 1원 미만 차이            | -
# SLIPPAGE_BPS              | 5bp (0.05%)   | 시장가 체결이 현재가보다 불리한 폭         | 성과가 보수적으로 나오고 매수가 줄어듦         | 성과가 부풀려짐
# PARTICIPATION_RATE        | 0.1           | 체결 1건의 거래량 중 내 주문이 가져가는 비율 | 빨리 다 체결됨 (1 이면 비현실적)             | 부분 체결이 늘어남 (보수적)
# STRATEGY_ORDER_VALUE      | 200만원       | 매수 1회 금액                              | 손익 폭 증가. 1회 한도를 넘으면 매수 전부 거부 | 1주 가격보다 작으면 그 종목 매수 불가
# RISK_MAX_ORDER_VALUE      | 250만원       | 주문 1건의 상한 (전략 버그 방지)           | 안전장치가 느슨해짐                            | 매수 금액보다 작으면 매수 전부 거부
# RISK_MAX_POSITION_VALUE   | 500만원       | 한 종목에 보유할 수 있는 상한              | 한 종목에 몰릴 위험 증가                       | 추가 매수가 막힘
# RISK_DAILY_LOSS_LIMIT     | 30만원 (3%)   | 이만큼 잃으면 그날 신규 매수 중단          | 나쁜 날 손실이 커짐                            | 정상적인 등락에도 매매가 멈춤
#
# 값 사이 관계: STRATEGY_ORDER_VALUE ≤ RISK_MAX_ORDER_VALUE ≤ RISK_MAX_POSITION_VALUE, 시작 현금 ≥ 1회 매수 금액
# ═════════════════════════════════════════════════════════════════════════════

# ── 가상 계좌 ────────────────────────────────────────────────────────────────

# 가상 계좌의 시작 현금 (원). 처음 기동할 때 한 번만 쓰고, 이후에는 DB 의 잔고를 이어 쓴다.
#   올리면: 현금 부족으로 막히는 일이 줄고 여러 종목을 동시에 들고 있을 수 있다.
#   내리면: 동시 보유 종목 수가 줄어든다. 1회 매수 금액보다 작으면 매수를 못 한다.
TRADER_PAPER_INITIAL_CASH=10000000

# ── 수수료·세금 (비율. 0.015% → 0.00015) ─────────────────────────────────────
# ⚠️ 확인 필요: 증권사·계좌 종류·이벤트에 따라 다르다. 실계좌(2단계) 전에 실제 요율로 바꾼다.

# 매수·매도 수수료율. 0.015% (온라인 주식 일반 수수료 수준, 유관기관 수수료 포함으로 가정)
#   올리면: 거래마다 비용이 커져 손익이 나빠지고, 비용 차감 손익비가 낮아져 매수가 더 자주 막힌다.
#   내리면: 비용이 실제보다 작게 잡혀 가상매매 성과가 실제보다 좋게 보인다 (과대평가 위험).
TRADER_COMMISSION_RATE_BUY=0.00015
TRADER_COMMISSION_RATE_SELL=0.00015

# 매도할 때만 붙는 세금 비율. 0.20% (증권거래세 + 농어촌특별세, 2026년 코스피·코스닥 기준으로 가정)
#   올리면/내리면: 수수료와 같다. 매도에만 붙으므로 짧게 자주 사고파는 전략일수록 영향이 크다.
#   지금 비용 중 가장 큰 항목이다 (수수료 왕복 0.03% < 세금 0.20%).
TRADER_SELL_TAX_RATE=0.0020

# 수수료·세금의 원 단위 처리. down(원 미만 절사) | half_up(반올림)
#   down: 비용이 아주 약간 작게 잡힌다. half_up: 아주 약간 크게 잡힌다. 주문 1건당 1원 미만 차이.
TRADER_FEE_ROUNDING=down

# ── 가상 체결 모델 ───────────────────────────────────────────────────────────

# 시장가로 사고팔 때 현재가보다 불리하게 체결된다고 보는 폭 (bp, 1bp = 0.01%). 5bp = 0.05%
# (하이닉스 호가 1틱 ≈ 0.1%, 삼성전자 ≈ 0.06% 이므로 반 틱 안팎)
#   올리면: 체결가가 불리해져 성과가 보수적으로 나오고, 손익비가 낮아져 매수가 줄어든다.
#   내리면: 실제보다 유리하게 체결된 것으로 보여 성과가 부풀려진다.
TRADER_SLIPPAGE_BPS=5

# 시세 1틱(체결 1건)의 거래량 중 내 주문이 가져갈 수 있는 비율 (0 초과 1 이하). 0.1 = 10%
# 예: 체결 20주가 찍히면 내 주문은 그중 2주까지만 체결된다 → 나머지는 다음 체결을 기다린다 (부분 체결).
#   올리면: 한 번에 많이 체결돼 빨리 다 채워진다. 1 이면 시장 거래량을 전부 내가 가져가는 비현실적 가정.
#   내리면: 체결이 느려지고 부분 체결·미체결이 많아진다 (보수적).
TRADER_PARTICIPATION_RATE=0.1

# ── 위험 한도 (원) ───────────────────────────────────────────────────────────
# 주문은 전략 → 위험 관리 → 주문 순서라, 아래 한도를 넘는 주문은 전략이 원해도 나가지 않는다.
# 보유분을 줄이는 매도(손절·청산)는 1회 금액·하루 손실 한도로 막지 않는다.

# 매수 신호가 났을 때 쓸 금액. 수량 = 이 금액 ÷ 현재가 (1주 미만 버림).
# 2,000,000원 → 삼성전자 약 11주, SK하이닉스 1주.
#   올리면: 한 번에 크게 사서 손익 폭이 커진다. 아래 1회 주문 한도보다 크면 모든 매수가 거부된다.
#   내리면: 손익 폭이 작아진다. 종목 1주 값보다 작으면 그 종목은 사지 못한다 (지금 하이닉스 ≈ 103만원).
TRADER_STRATEGY_ORDER_VALUE=2000000

# 주문 1건의 최대 금액. 전략 버그로 큰 주문이 나가는 것을 막는 안전장치.
# 매수 금액보다 조금 크게 둔다 (주문 시점 가격이 판단 시점보다 오를 수 있어서).
#   올리면: 안전장치가 느슨해진다.
#   내리면: 매수 금액보다 작아지면 모든 매수가 MAX_ORDER_VALUE 로 거부된다.
TRADER_RISK_MAX_ORDER_VALUE=2500000

# 한 종목에 들고 있을 수 있는 최대 금액 (보유 + 미체결 매수 + 이번 주문). 한 종목 몰빵을 막는다.
# 5,000,000원 → 같은 종목 매수 금액 기준 2번까지 쌓을 수 있다.
#   올리면: 한 종목에 더 많이 쌓여 그 종목 급락 때 손실이 커진다.
#   내리면: 추가 매수가 막힌다. 매수 금액보다 작으면 그 종목을 처음부터 사지 못한다.
TRADER_RISK_MAX_POSITION_VALUE=5000000

# 하루 손실 한도. 오늘 시작 평가금액 대비 (평가손익 포함) 이만큼 잃으면 그날 신규 매수를 멈춘다.
# 300,000원 = 시작 현금의 3%.
#   올리면: 나쁜 날에도 계속 매수해 손실이 더 커질 수 있다.
#   내리면: 조금만 잃어도 그날 매매가 멈춘다. 너무 작으면 정상적인 등락에도 멈춰 신호 성과가 덜 쌓인다.
TRADER_RISK_DAILY_LOSS_LIMIT=300000

# ── 손익비 기준 (기본값이 있어 선택. 바꾸려면 주석을 풀어 쓴다) ─────────────────
# 손절가 = 진입가 − ATR × 손절 배수, 목표가 = 진입가 + ATR × 목표 배수 (ATR = 1분봉 14개 평균 변동폭)
# 비용(수수료·세금·슬리피지)을 뺀 "기대 이익 ÷ 감수 손실" 이 최소 손익비보다 작으면 매수하지 않는다.
# 지금 값(1.5)에서는 1분봉 기준 손익비가 0.8~1.1 로 나와 매수가 거의 막힌다 — 아직 결정 전.
#   최소 손익비 올리면: 매수가 더 드물어지고, 들어갈 때는 기대 이익이 큰 자리만 들어간다.
#   최소 손익비 내리면: 매수가 늘지만 비용을 빼면 본전도 안 되는 자리에도 들어갈 수 있다.
# TRADER_RISK_ATR_STOP_MULT=1.5
# TRADER_RISK_ATR_TAKE_MULT=3
# TRADER_RISK_MIN_RISK_REWARD=1.5
