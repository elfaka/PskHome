# 서버의 server/trader.env 템플릿. 복사해서 서버에서만 채운다 (git·채팅·로그에 남기지 않는다).
# 비밀번호는 trader/db/create_users.sql 을 실행할 때 정한 값이다.
# 비밀번호에 @ : / ? # 가 있으면 퍼센트 인코딩한다.

TRADER_DATABASE_URL=mysql+pymysql://trader_app:<APP_PASSWORD>@pskhome-db-1:3306/trader
TRADER_MIGRATE_DATABASE_URL=mysql+pymysql://trader_migrate:<MIGRATE_PASSWORD>@pskhome-db-1:3306/trader

TRADER_ACCOUNT_NAME=paper-default
TRADER_SYMBOLS=005930

# ── 아래는 trader/.env.example 과 같은 항목. 비어 있으면 엔진이 기동하지 않는다 ──
TRADER_PAPER_INITIAL_CASH=
TRADER_COMMISSION_RATE_BUY=
TRADER_COMMISSION_RATE_SELL=
TRADER_SELL_TAX_RATE=
TRADER_FEE_ROUNDING=
TRADER_SLIPPAGE_BPS=
TRADER_PARTICIPATION_RATE=
TRADER_RISK_MAX_ORDER_VALUE=
TRADER_RISK_MAX_POSITION_VALUE=
TRADER_RISK_DAILY_LOSS_LIMIT=
TRADER_STRATEGY_ORDER_VALUE=
