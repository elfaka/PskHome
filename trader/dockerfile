# trader 엔진 이미지. GitHub Actions 에서 빌드해 GHCR(ghcr.io/elfaka/pskhome-trader)에 올린다.
# 실행:      trader run
# 마이그레이션: alembic upgrade head   (TRADER_MIGRATE_DATABASE_URL 필요)

FROM python:3.12-slim AS build
COPY --from=ghcr.io/astral-sh/uv:0.13.6 /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY src ./src
RUN uv sync --frozen --no-dev

FROM python:3.12-slim
# 권한 없는 사용자로 실행한다
RUN useradd --system --uid 10001 --no-create-home trader
WORKDIR /app
COPY --from=build /app/.venv /app/.venv
COPY --from=build /app/src /app/src
COPY alembic.ini ./
COPY migrations ./migrations
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    TZ=UTC
USER trader
# 실주문 모드는 존재하지 않는다 (TRADER_MODE 는 paper 만 허용)
CMD ["trader", "run"]
