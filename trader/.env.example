# ─────────────────────────────────────────────────────────────────────────────
# trader 엔진 설정 템플릿. `.env` 로 복사해 채운다. `.env` 는 git 에 올리지 않는다.
# 비어 있는 값은 필수다 — 채우지 않으면 엔진이 기동하지 않는다.
# ─────────────────────────────────────────────────────────────────────────────

# ── 로컬 개발용 MySQL 컨테이너 (compose.dev.yaml 이 읽는다) ──────────────────
DEV_MYSQL_ROOT_PASSWORD=
DEV_TRADER_APP_PASSWORD=
DEV_TRADER_MIGRATE_PASSWORD=

# ── DB 접속 ──────────────────────────────────────────────────────────────────
# 엔진: DML 권한만 가진 계정
TRADER_DATABASE_URL=mysql+pymysql://trader_app:<password>@127.0.0.1:3307/trader
# 마이그레이션(alembic): 이 DB 의 DDL 권한을 가진 계정
TRADER_MIGRATE_DATABASE_URL=mysql+pymysql://trader_migrate:<password>@127.0.0.1:3307/trader
# pytest 의 MySQL 테스트용 (없으면 해당 테스트는 건너뛴다). 반드시 별도 DB(trader_test)
TRADER_TEST_DATABASE_URL=mysql+pymysql://trader_migrate:<password>@127.0.0.1:3307/trader_test

# ── 실행 ─────────────────────────────────────────────────────────────────────
TRADER_MODE=paper
TRADER_ACCOUNT_NAME=paper-default
TRADER_LOG_LEVEL=INFO
TRADER_LOG_JSON=true

# ── 시세 ─────────────────────────────────────────────────────────────────────
# synthetic | csv
TRADER_FEED=synthetic
# fast(가상 시계로 재생) | realtime(실제 시각, synthetic 만)
TRADER_PACE=fast
# TRADER_FEED_CSV_PATH=data/sample_ticks.csv
TRADER_SYMBOLS=005930
TRADER_SYNTHETIC_SEED=42
TRADER_SYNTHETIC_START_PRICE=70000
TRADER_SYNTHETIC_TICK_SIZE=100
TRADER_SYNTHETIC_TICK_SECONDS=10
TRADER_SYNTHETIC_DAYS=1
TRADER_BAR_INTERVAL_SECONDS=60
TRADER_MAX_QUOTE_AGE_SECONDS=5
TRADER_MAX_MISSING_BARS=2
# 장 시간 (KST). 동시호가·휴장일 등 세부 규칙은 확인 필요
TRADER_ENFORCE_MARKET_HOURS=true
TRADER_MARKET_OPEN=09:00
TRADER_MARKET_CLOSE=15:20

# ── 가상 브로커: 수수료·세금·슬리피지 (확인 후 직접 채울 것) ──────────────────
TRADER_PAPER_INITIAL_CASH=
# 비율. 예: 0.015% 이면 0.00015
TRADER_COMMISSION_RATE_BUY=
TRADER_COMMISSION_RATE_SELL=
# 매도 시 거래세 등 (비율)
TRADER_SELL_TAX_RATE=
# 수수료·세금 원 단위 처리: down(절사) | half_up(반올림)
TRADER_FEE_ROUNDING=
# 시장가 체결 시 불리하게 적용할 슬리피지 (bp, 1bp = 0.01%)
TRADER_SLIPPAGE_BPS=
# 시세 틱 거래량 중 내 주문이 체결될 수 있는 비율 (0 초과 1 이하). 부분 체결 모델
TRADER_PARTICIPATION_RATE=
TRADER_PRICE_DECIMALS=0

# ── 위험 관리 (원) ───────────────────────────────────────────────────────────
TRADER_RISK_MAX_ORDER_VALUE=
TRADER_RISK_MAX_POSITION_VALUE=
TRADER_RISK_DAILY_LOSS_LIMIT=
TRADER_RISK_APPROVAL_TTL_SECONDS=5

# ── 전략: 이동평균 교차 ──────────────────────────────────────────────────────
TRADER_STRATEGY_FAST=5
TRADER_STRATEGY_SLOW=20
TRADER_STRATEGY_ORDER_VALUE=
