# PskHome 프론트엔드 (Next.js App Router)
#
# 기존에는 `nginx:alpine` 에 Vite 정적 빌드(dist/)를 볼륨으로 물려 서빙했다.
# Next 는 Node 런타임이 필요하므로 standalone 출력을 담은 이미지를 직접 빌드한다.
#
# 이 이미지는 GitHub Actions 에서 빌드해 GHCR 로 올라간다 (서버에서 빌드하지 않는다).
# 로컬에서 확인하려면: `docker build -f frontend/dockerfile -t pskhome-fe frontend`

FROM node:22-alpine AS deps

# Next 의 SWC 네이티브 바이너리는 alpine(musl) 에서 libc6-compat 을 요구한다.
# 없으면 빌드 중 바이너리 로드에 실패한다. (Next 공식 Dockerfile 예제와 동일)
RUN apk add --no-cache libc6-compat

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci


FROM node:22-alpine AS builder

RUN apk add --no-cache libc6-compat

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build


FROM node:22-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

COPY --from=builder /app/public ./public

# standalone 출력은 실행에 필요한 node_modules 를 이미 포함한다.
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

EXPOSE 3000

CMD ["node", "server.js"]
